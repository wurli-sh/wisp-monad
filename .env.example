# Web public (safe to expose in Next.js)
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# API only — never expose in NEXT_PUBLIC_*
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
MONAD_INDEXER_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_INDEXER_WS_URL=
REDIS_URL=
REDIS_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CLAIM_PAYLOAD_ENC_KEYS_JSON={"1":"replace-with-32-char-secret"}
INVITE_STATUS_HMAC_KEYS_JSON={"1":"replace-with-32-char-secret"}
INDEXER_ADMIN_TOKEN=
# Exact comma-separated web origins. Wildcard is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public API origin used in signed wallet-link challenges.
API_ORIGIN=http://localhost:8787
PORT=8787
LOG_LEVEL=info

# Deployment only; named Foundry keystore required — never put a private key here
FOUNDRY_ACCOUNT=wisp-deployer
MONAD_DEPLOY_RPC_URL=https://testnet-rpc.monad.xyz
WISP_ADMIN_ADDRESS=
WISP_KEYSTORE_PASSWORD_FILE=
