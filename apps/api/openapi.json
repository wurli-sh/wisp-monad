{
  "openapi": "3.1.0",
  "info": {
    "title": "Wisp Phase 2 API",
    "version": "1.0.0",
    "description": "Bearer-authenticated resolver, encrypted delivery, invite, and Merkle path API."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase JWT"
      },
      "adminToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-admin-token"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Dependencies ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/resolve": {
      "get": {
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 320
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resolver result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/wallet/challenge": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "chainId": {
                    "type": "number",
                    "enum": [
                      10143
                    ]
                  }
                },
                "required": [
                  "address",
                  "chainId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One-use challenge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/wallet/link": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "chainId": {
                    "type": "number",
                    "enum": [
                      10143
                    ]
                  },
                  "signature": {
                    "type": "string",
                    "pattern": "^0x(?:[0-9a-f]{2})+$"
                  },
                  "challenge": {
                    "type": "string"
                  },
                  "inboxSignature": {
                    "type": "string",
                    "pattern": "^0x(?:[0-9a-f]{2})+$"
                  },
                  "inboxPubkey": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "address",
                  "chainId",
                  "signature",
                  "challenge",
                  "inboxSignature",
                  "inboxPubkey"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Wallet linked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/handles/{id}": {
      "delete": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Handle unlinked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notes": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipientPubkey": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "ephemeralPubkey": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "nonce": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{48}$"
                  },
                  "ciphertext": {
                    "type": "string",
                    "pattern": "^0x(?:[0-9a-f]{2})+$"
                  }
                },
                "required": [
                  "recipientPubkey",
                  "ephemeralPubkey",
                  "nonce",
                  "ciphertext"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Encrypted note stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Encrypted notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notes/{id}/claimed": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Note marked claimed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/merkle/path": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pool": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "commitment": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "pool",
                  "commitment"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current contract-known Merkle path",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/invites": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "normalizedHandle": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 320
                  },
                  "deliveryKind": {
                    "type": "string",
                    "enum": [
                      "email"
                    ]
                  },
                  "recipientEmail": {
                    "type": "string",
                    "format": "email"
                  },
                  "claimPayload": {
                    "type": "object",
                    "properties": {
                      "v": {
                        "type": "number",
                        "enum": [
                          1
                        ]
                      },
                      "chainId": {
                        "type": "number",
                        "enum": [
                          10143
                        ]
                      },
                      "pool": {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{40}$"
                      },
                      "token": {
                        "type": "string",
                        "enum": [
                          "0x534b2f3A21130d7a60830c2Df862319e593943A3"
                        ]
                      },
                      "denomination": {
                        "type": "string",
                        "enum": [
                          "1000000",
                          "10000000",
                          "50000000",
                          "100000000"
                        ]
                      },
                      "secret": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      },
                      "recipientKeyDigest": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      },
                      "commitment": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      },
                      "depositTxHash": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "v",
                      "chainId",
                      "pool",
                      "token",
                      "denomination",
                      "secret",
                      "recipientKeyDigest",
                      "commitment",
                      "depositTxHash"
                    ],
                    "additionalProperties": false
                  },
                  "logIndex": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "normalizedHandle",
                  "deliveryKind",
                  "recipientEmail",
                  "claimPayload",
                  "logIndex"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email invite delivered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sender invite status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/activity": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipientPubkey": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "ephemeralPubkey": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  },
                  "nonce": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{48}$"
                  },
                  "ciphertext": {
                    "type": "string",
                    "pattern": "^0x(?:[0-9a-f]{2})+$"
                  }
                },
                "required": [
                  "recipientPubkey",
                  "ephemeralPubkey",
                  "nonce",
                  "ciphertext"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Encrypted activity stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Encrypted activity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/reindex": {
      "post": {
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Durable indexer cache reset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
