{
  "name": "@wisp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:indexer": "tsx watch src/indexer.ts",
    "build": "pnpm run typecheck && pnpm run openapi:generate",
    "start": "node --import tsx/esm src/server.ts",
    "start:indexer": "node --import tsx/esm src/indexer.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "node --import tsx/esm src/openapi/write.ts",
    "test": "node --import tsx/esm --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@supabase/supabase-js": "2.49.1",
    "@upstash/redis": "1.34.5",
    "@wisp/crypto": "workspace:*",
    "@wisp/shared": "workspace:*",
    "fastify": "5.8.5",
    "jose": "5.10.0",
    "pino": "9.6.0",
    "resend": "4.1.2",
    "tweetnacl": "1.0.3",
    "tsx": "4.19.3",
    "viem": "2.23.15",
    "zod": "3.24.2",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "pino-pretty": "13.0.0",
    "typescript": "5.8.3"
  }
}
